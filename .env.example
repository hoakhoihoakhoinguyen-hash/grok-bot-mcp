# Exact webhook URL copied from the routine panel. https, port 443, no query.
GROK_BOT_WEBHOOK_URL=https://bot.example/webhook

# Hostname only, copied from that URL. The server will not call any other host.
WEBHOOK_HOST_ALLOWLIST=bot.example

# Sender key from the routine panel's key field. The server adds "Bearer ".
GROK_BOT_WEBHOOK_KEY=replace-with-the-routine-sender-key

# Credential for the reply connector only. Never paste this into the routine text.
# Must differ from every MCP caller secret and be at least 16 characters.
REPLY_SECRET=replace-with-a-long-random-secret

# Caller keys. The Desktop bridge sends only the secret half, after the first colon.
MCP_API_KEY=desktop:replace-with-a-long-random-secret

# Public origin of this deployment, no path and no trailing slash.
PUBLIC_BASE_URL=https://mcp.example

# ask_bot wait in seconds. Default 0. Hard maximum 5.
# WAIT_SECONDS=0

# Job TTL in seconds. Default 900. Hard maximum 3600. Minimum 60.
# JOB_TTL_SECONDS=900

# Maximum accepted message size in UTF-8 bytes. Default 16384.
# MAX_MESSAGE_BYTES=16384

# Webhook POST timeout in milliseconds. Default 8000. One attempt, no retry, no redirect.
# WEBHOOK_TIMEOUT_MS=8000

# Optional consistent store. Both values required together. Public https only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local dev only. Unset storage uses one process's memory.
# PORT=3000
